# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example lists names with placeholders only, so it is committed.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
tarot.db
*.db-shm
*.db-wal

scripts/migrate.ts
# This computer's own KoboldCpp paths; the .example.json beside it is the committed template.
scripts/koboldcpp-startup.local.json
EncyclopediaArcana/
koboldcpp-linux-x64-nocuda

# editor swap files
*.swp
*.swo
docs/companion-bakeoff/
# The editor settings for linting and tidying on save are shared; anything else in .vscode stays on this computer.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Playwright screen-reader test output
/test-results/
/playwright-report/
/dist

# the owner's reference bundle (the encyclopedia text; see docs/provenance.md): never committed
/data/reference-bundle.json
