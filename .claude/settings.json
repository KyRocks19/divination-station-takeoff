{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\" push",
            "timeout": 10,
            "statusMessage": "Checking for git push..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\" live",
            "timeout": 10,
            "statusMessage": "Checking the command is not aimed at the live database..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\" heredoc",
            "timeout": 10,
            "statusMessage": "Checking for a heredoc..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)"
    ]
  }
}
