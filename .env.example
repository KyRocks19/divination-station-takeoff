# Copy this file to .env.local and fill in what you need. Never commit .env.local (it is git-ignored).
# Every value below is a placeholder. The README lists what each one does.

# --- Needed -------------------------------------------------------------------------------------------
# Postgres connection string. For Neon use sslmode=verify-full.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# Random text of 32 or more characters; it encrypts the sign-in cookie. Make your own, never reuse one.
SESSION_SECRET=

# --- Which edition this copy is (docs/plan-editions.md) ----------------------------------------------------
# Leave empty for a hosted copy. Set to "local" on a copy you run on your own computer: it then answers only
# to localhost, 127.0.0.1 and [::1].
DS_EDITION=
# Only with DS_EDITION=local: "host" makes this copy also serve the circle of the person who runs it, over Tailscale (docs/plan-host-mode.md).
# It turns on the circle, forum, join and invite pages and caps a circle at 10 people. Empty = a copy for one person. Ignored on a hosted copy.
DS_MODE=
# Numeric ID of the one circle allowed to use the hosted app. Production builds deny access if this is unset or invalid.
# Local editions with DS_DB_DIR ignore this setting.
DS_FAMILY_CIRCLE_ID=
# Extra host names this copy may be reached by, comma separated (for example a Tailscale name). Setting this
# turns the host check on even for a hosted copy. Leave empty if you do not use it.
ALLOWED_HOSTS=
# Extra web addresses whose pages may send changes to this app (rarely needed).
ALLOWED_ORIGINS=

# Set to a folder on this computer to keep ALL data in it instead of a Postgres server (the local edition; PGlite). The folder is made and
# brought up to date on first use. On first start the copy also makes its own SESSION_SECRET and CIRCLE_KEY_SECRET and saves them in
# "<folder>.secrets.json" beside it (keep that file with the folder); a value set here instead wins. Leave empty on a hosted copy.
DS_DB_DIR=
# Optional: a reference bundle file (made by scripts/export-reference-bundle.ts) that fills a new local folder's encyclopedia. Default data/reference-bundle.json.
DS_REFERENCE_BUNDLE=

# The most accounts a hosted copy holds (200 if empty; 0 means no ceiling).
MAX_ACCOUNTS=

# --- First account (only used by `npm run migrate` on an empty database) -----------------------------------
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# --- Claude (all optional; without a key the Claude features are off) -------------------------------------
ANTHROPIC_API_KEY=
# Daily limits. Defaults: 15 per person, 300 for everyone.
AI_DAILY_LIMIT=
AI_GLOBAL_DAILY_LIMIT=
# 32 random bytes as 64 hex characters or base64. Needed only if circle owners bring their own Claude key.
# If it is lost, saved circle keys cannot be opened.
CIRCLE_KEY_SECRET=

# --- Limits shared between servers (optional; each server counts alone without them) -----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pictures and local models (optional; set on the computer that has the tool, never on a cloud server) ---
IMAGE_GEN_URL=
# Optional, for the program at IMAGE_GEN_URL: koboldcpp (default; also AUTOMATIC1111, Forge, SD.Next) or comfyui; ComfyUI's model file;
# sdxl for an SDXL model's own picture size (slower); steps and guidance (default 20 and 7). See docs/picture-model-at-home.md.
IMAGE_GEN_KIND=
IMAGE_GEN_MODEL=
IMAGE_GEN_SIZE=
IMAGE_GEN_STEPS=
IMAGE_GEN_CFG=
ART_DIR=
ART_REQUIRE_DISK=
KOBOLDCPP_URL=
COMPANION_URL=

# --- The picture studio program (scripts/image-worker.ts) -------------------------------------------------
# The website whose queue it works for, and the token made at Admin > Picture computers (or by a circle owner).
APP_URL=
WORKER_TOKEN=
# Optional: the doorbell address (rediss://...) so the studio wakes at once when a picture is asked for.
UPSTASH_REDIS_URL=

# --- Development only (put these in .env.development.local) ------------------------------------------------
# Other hostnames the dev server may serve, comma-separated, for example your-pc.your-tailnet.ts.net
DEV_ALLOWED_ORIGINS=
# Optional: the first letters of your dev database host, for example ep-your-dev-branch (scripts/dev-database.ts)
DEV_DATABASE_HOST_PREFIX=
